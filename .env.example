# このファイルを.envへコピーし、利用環境に合わせて値を変更する。

# 統合認証端末からSmart Gate APIへ接続するための設定
AUTH_APP_BEARER_TOKEN=replace-with-a-long-random-token
AUTH_API_BASE_URL=http://localhost:3000
AUTH_API_ATTENDANCE_ENDPOINT=/api/v1/attendance-events
AUTH_DEVICE_ID=smart-gate-terminal-01

# 顔登録APIを保護するための設定
FACE_AUTH_APP_BEARER_TOKEN=replace-with-a-long-random-token

# 顔登録API、顔認証単体、統合認証端末で共通利用する設定
FACE_AUTH_DB_PATH=face/face.db
FACE_AUTH_MODEL_NAME=buffalo_sc

# 顔登録APIの検出設定
FACE_AUTH_DET_SIZE=320

# 顔認証単体と統合認証端末の判定設定
FACE_AUTH_THRESHOLD=0.5

# 統合認証端末のLCD設定
AUTH_LCD_BUS=1
AUTH_LCD_ADDRESS=0x27
