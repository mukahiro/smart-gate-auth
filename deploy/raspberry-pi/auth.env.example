# Web APIのAUTH_APP_BEARER_TOKENと同じ値を設定する。
AUTH_APP_BEARER_TOKEN=replace-with-a-long-random-event-token
AUTH_API_BASE_URL=http://127.0.0.1:3000
AUTH_API_ATTENDANCE_ENDPOINT=/api/v1/attendance-events
AUTH_DEVICE_ID=smart-gate-terminal-01
# Web APIのFACE_AUTH_APP_BEARER_TOKENと同じ値を設定する。
FACE_AUTH_APP_BEARER_TOKEN=replace-with-a-different-long-random-face-token
FACE_AUTH_DB_PATH=/var/lib/smart-gate-auth/face.db
FACE_AUTH_MODEL_NAME=buffalo_sc
FACE_AUTH_DET_SIZE=320
FACE_AUTH_THRESHOLD=0.5
AUTH_LCD_BUS=1
AUTH_LCD_ADDRESS=0x27
